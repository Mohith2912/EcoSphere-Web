NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ecosphere"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Required only to bootstrap the first organization owner; leave unset to disable bootstrap.
ORGANIZATION_BOOTSTRAP_SECRET=
