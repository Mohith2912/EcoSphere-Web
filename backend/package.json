{
  "name": "ecosphere-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EcoSphere modular-monolith REST API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint src test",
    "check": "node --check src/server.js && node --check src/app.js"
    ,"db:generate": "prisma generate"
    ,"db:push": "prisma db push"
    ,"db:seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "eslint": "^9.20.1",
    "nodemon": "^3.1.9",
    "prisma": "6.19.3"
  }
}
